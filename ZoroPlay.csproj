<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ZoroPlay</AssemblyName>
    <RootNamespace>ZoroPlay</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- version.txt is the single source of truth (CI watches it) -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/version.txt').Trim())</Version>
    <!-- the Vite project is not part of the .NET build -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElectronNET.API" Version="23.6.2" />
    <None Update="electron.manifest.json" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- ===== native DLL: fail early, then copy it explicitly next to the exe ===== -->
  <Target Name="RequireDll" BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildProjectDirectory)/native/manymouse.dll')">
    <Error Text="native/manymouse.dll (x64) is missing. Copy it there and commit it." />
  </Target>
  <Target Name="CopyDllBuild" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/native/manymouse.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyDllPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/native/manymouse.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- ===== React UI (Vite) -> wwwroot. Skipped when ZORO_VITE_URL is set (dev server) ===== -->
  <Target Name="BuildClient" BeforeTargets="BeforeBuild"
          Condition="'$(ZORO_VITE_URL)' == '' And '$(SkipClient)' != 'true'">
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp"
          Condition="!Exists('$(MSBuildProjectDirectory)/ClientApp/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" />
  </Target>

  <!-- wwwroot is generated during the build, so add it to the publish list by hand -->
  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <DistFiles Include="wwwroot/**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
